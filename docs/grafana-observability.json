{
  "title": "hfproxy observability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [{ "name": "datasource", "type": "datasource", "query": "prometheus", "current": {} }] },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Requests per second", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "sum(rate(hfproxy_http_requests_total[5m]))", "legendFormat": "requests/s" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 } },
    { "id": 2, "type": "timeseries", "title": "HTTP error rate", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "sum(rate(hfproxy_http_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(hfproxy_http_requests_total[5m])), 1e-9)", "legendFormat": "5xx ratio" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 } },
    { "id": 3, "type": "timeseries", "title": "HTTP latency p50 / p95 / p99", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "histogram_quantile(0.50, sum by (le) (rate(hfproxy_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" }, { "expr": "histogram_quantile(0.95, sum by (le) (rate(hfproxy_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" }, { "expr": "histogram_quantile(0.99, sum by (le) (rate(hfproxy_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 } },
    { "id": 4, "type": "timeseries", "title": "Cache hits and misses", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "sum by (result) (rate(hfproxy_cache_requests_total[5m]))", "legendFormat": "{{result}}" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 } },
    { "id": 5, "type": "timeseries", "title": "Client bandwidth", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "sum(rate(hfproxy_http_response_bytes_total[5m]))", "legendFormat": "bytes/s" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 } },
    { "id": 6, "type": "timeseries", "title": "Active requests", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "hfproxy_http_requests_in_flight", "legendFormat": "in flight" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 } },
    { "id": 7, "type": "timeseries", "title": "Cache hit ratio", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "sum(rate(hfproxy_cache_requests_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(hfproxy_cache_requests_total{result=~\"hit|miss\"}[5m])), 1e-9)", "legendFormat": "hit ratio" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 } },
    { "id": 8, "type": "timeseries", "title": "Upstream error rate", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "sum(rate(hfproxy_upstream_errors_total[5m])) / clamp_min(sum(rate(hfproxy_upstream_requests_total[5m])), 1e-9)", "legendFormat": "error ratio" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 } },
    { "id": 9, "type": "timeseries", "title": "Upstream latency p95", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(hfproxy_upstream_request_duration_seconds_bucket[5m])))", "legendFormat": "{{operation}}" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 } },
    { "id": 10, "type": "timeseries", "title": "Active downloads", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "hfproxy_downloads_in_flight", "legendFormat": "sessions" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 } },
    { "id": 11, "type": "timeseries", "title": "Download throughput", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "sum by (source) (rate(hfproxy_download_bytes_total[5m]))", "legendFormat": "{{source}} bytes/s" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 } },
    { "id": 12, "type": "timeseries", "title": "Upstream bandwidth", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "sum(rate(hfproxy_upstream_bytes_received_total[5m]))", "legendFormat": "bytes/s" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 } },
    { "id": 13, "type": "stat", "title": "Cache storage size", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "hfproxy_cache_size_bytes", "legendFormat": "bytes" }], "gridPos": { "h": 6, "w": 6, "x": 0, "y": 48 } },
    { "id": 14, "type": "stat", "title": "Cache objects", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "hfproxy_cache_objects", "legendFormat": "objects" }], "gridPos": { "h": 6, "w": 6, "x": 6, "y": 48 } },
    { "id": 15, "type": "timeseries", "title": "Storage operation failures", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "targets": [{ "expr": "sum by (operation) (rate(hfproxy_storage_errors_total[5m]))", "legendFormat": "{{operation}}" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 } }
  ]
}
