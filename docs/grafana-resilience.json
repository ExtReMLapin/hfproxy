{
  "title": "hfproxy resilience and limits",
  "uid": "hfproxy-resilience",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "hfproxy"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability, last hour (objective 99.5%)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "1 - sum(rate(hfproxy_http_requests_total{route=~\"/(models|datasets|spaces)/.*\", status_code=~\"5..\"}[1h])) / clamp_min(sum(rate(hfproxy_http_requests_total{route=~\"/(models|datasets|spaces)/.*\"}[1h])), 1e-9)",
          "legendFormat": "availability"
        }
      ],
      "description": "Share of download requests without a 5xx. See slo.md.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.995
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fast cache hits, last hour (objective 95%)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(hfproxy_download_ttfb_seconds_bucket{cache=\"hit\", le=\"0.5\"}[1h])) / clamp_min(sum(rate(hfproxy_download_ttfb_seconds_count{cache=\"hit\"}[1h])), 1e-9)",
          "legendFormat": "within 500 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Downloads rejected by a limit, last hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(hfproxy_download_rejected_total[1h]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "description": "Downloads refused with 429 by the concurrency limit or the daily quota.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Upstream circuits opened, last hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (host) (increase(hfproxy_upstream_breaker_opened_total[1h]))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Time to first byte (p50 / p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, cache) (rate(hfproxy_download_ttfb_seconds_bucket[5m])))",
          "legendFormat": "p50 {{cache}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, cache) (rate(hfproxy_download_ttfb_seconds_bucket[5m])))",
          "legendFormat": "p95 {{cache}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Downloads by result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(hfproxy_downloads_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "description": "Sessions: success, failed, cancelled, partial (range requests).",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Download failures by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(hfproxy_download_failures_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Downloads rejected by the limits",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(hfproxy_download_rejected_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "description": "concurrency: too many simultaneous downloads; quota: the daily quota is spent.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Hub errors by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(hfproxy_upstream_errors_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Circuit breaker",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (host) (rate(hfproxy_upstream_breaker_opened_total[5m]))",
          "legendFormat": "opened {{host}}"
        },
        {
          "expr": "sum by (host) (rate(hfproxy_upstream_breaker_rejected_total[5m]))",
          "legendFormat": "rejected {{host}}"
        }
      ],
      "description": "Requests rejected while a circuit is open fail fast or are answered from the cache.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Hub retries and latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(hfproxy_upstream_retries_total[5m]))",
          "legendFormat": "retries {{operation}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(hfproxy_upstream_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 s {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Staging volume",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "hfproxy_staging_free_bytes",
          "legendFormat": "free"
        },
        {
          "expr": "hfproxy_staging_reserved_bytes",
          "legendFormat": "reserved by fills"
        }
      ],
      "description": "Fills are refused with 507 when free space is short of the file.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Cache size and pinned content",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "hfproxy_cache_size_bytes",
          "legendFormat": "cache"
        },
        {
          "expr": "hfproxy_cache_pinned_bytes",
          "legendFormat": "pinned"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Evictions per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(increase(hfproxy_cache_evictions_total[1h]))",
          "legendFormat": "evicted files"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Storage operation latency (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(hfproxy_storage_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Storage errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(hfproxy_storage_errors_total[5m]))",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Orphaned blob collection",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (result) (increase(hfproxy_gc_runs_total[3h]))",
          "legendFormat": "runs {{result}} (3 h)"
        },
        {
          "expr": "sum(increase(hfproxy_gc_blobs_deleted_total[3h]))",
          "legendFormat": "blobs deleted (3 h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Time since the last collection",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "time() - hfproxy_gc_last_run_timestamp_seconds and hfproxy_gc_last_run_timestamp_seconds > 0",
          "legendFormat": "seconds"
        }
      ],
      "description": "Collection runs hourly; the alert fires after three hours.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 7200
              },
              {
                "color": "red",
                "value": 10800
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      }
    }
  ]
}
